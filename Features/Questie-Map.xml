<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!--
		One of Questie's quest icons, drawn again on the map. The canvas makes its pins from a named
		template, which only XML can declare
	-->
	<Frame name="PrettyWideQuestLogQuestiePinTemplate" mixin="MapCanvasPinMixin" enableMouse="true" virtual="true">
		<Size x="12" y="12"/>
		<Layers>
			<Layer level="ARTWORK" textureSubLevel="-1">
				<Texture parentKey="Glow" hidden="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Texture" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
	<!--
		The layer the selected quest's objective areas are drawn on, as large as the map
		(Questie-Map-Area-Layer.lua). It takes no mouse, so dragging the map and hovering the icons above it pass
		straight through
	-->
	<Frame name="PrettyWideQuestLogAreaPinTemplate" mixin="MapCanvasPinMixin" virtual="true"/>
</Ui>
