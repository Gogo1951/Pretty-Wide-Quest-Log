<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!--
		The map docked to the right of the quest log, built on Blizzard's map canvas the way the
		Battlefield Map is. The canvas's OnLoad needs its ScrollContainer to exist, which only XML can
		arrange, so the frame is declared here and set up in Quest-Map.lua
	-->
	<Frame name="PrettyWideQuestLogMapFrame" inherits="MapCanvasFrameTemplate">
		<Size x="600" y="400"/>
		<Frames>
			<ScrollFrame parentKey="ScrollContainer" inherits="MapCanvasFrameScrollContainerTemplate">
				<Anchors>
					<Anchor point="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT"/>
				</Anchors>
			</ScrollFrame>
			<!-- The canvas turns this on to block the mouse while the map is locked -->
			<Frame parentKey="BorderFrame" setAllPoints="true"/>
		</Frames>
	</Frame>
	<!--
		The shown quest's marker on WoW Forever and Mists (Forever-Quest-Map.lua), the size of Questie's
		icons (Questie-Map.lua). It takes no mouse, so dragging the map passes straight through and a click
		on it runs nothing
	-->
	<Frame name="PrettyWideQuestLogQuestMarkerPinTemplate" mixin="PrettyWideQuestLogPinMixin" virtual="true">
		<Size x="24" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Texture" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
	<!--
		Where the player is, on the world map and the quest map (Player-Map-Pin.lua): the Quest Arrow's
		arrow at half its size, as the Next Objective's is, in their class color. It takes no mouse either
	-->
	<Frame name="PrettyWideQuestLogPlayerPinTemplate" mixin="PrettyWideQuestLogPinMixin" virtual="true">
		<Size x="32" y="32"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Arrow" file="Interface\AddOns\Pretty-Wide-Quest-Log\Includes\Images\Route-Arrow" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
	<!--
		A party member, on the world map and the quest map (Player-Map-Pin.lua): the disc the route's
		waypoints are drawn on, black ring and all, in their class color, a step smaller than the arrow so
		the player stands out. It takes the mouse's motion only, set in Lua
	-->
	<Frame name="PrettyWideQuestLogPartyPinTemplate" mixin="PrettyWideQuestLogPinMixin" virtual="true">
		<Size x="16" y="16"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Disc" file="Interface\AddOns\Pretty-Wide-Quest-Log\Includes\Images\Route-Stop" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
</Ui>
